{
  "expo": {
    "name": "Next Page",
    "slug": "bookstore-app",
    "owner": "harba-media",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "apiUrl": "https://bookstore-backend-ios.onrender.com/api",
      "stripePublishableKey": "",
      "router": {},
      "eas": {
        "projectId": "45abe120-30ee-4977-8188-fee5b3c1141c"
      }
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.bookstore.harba.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera access is used to scan your card securely during checkout."
      }
    },
    "android": {
      "versionCode": 24,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.bookstore.harba.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "meta": {
        "google-site-verification": "f4hE6CjKLJ6awC43ORfLGx9m34-MYJy13FZ3qqSpNw8"
      }
    },
    "scheme": "bookstore",
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ]
  }
}
